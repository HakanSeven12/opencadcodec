; Body_AC1015.scr - golden_entities fixture, headless per fixtures/README_HEADLESS.md
; engine : BricsCAD V26 hidden /Automation /b
; seed   : staged acadiso.dwt | one op | SAVEAS token "2000"
_.LOGFILEON
_.OPEN
C:\Users\SebastianSchoeller\AppData\Local\Temp\kilo\golden\seed\acadiso.dwt
(entmake '((0 . "CIRCLE") (100 . "AcDbEntity") (100 . "AcDbCircle") (10 0.0 0.0 0.0) (40 . 5.0)))
(setq _c1 (entlast))
(entmake '((0 . "CIRCLE") (100 . "AcDbEntity") (100 . "AcDbCircle") (10 3.0 0.0 0.0) (40 . 5.0)))
(setq _c2 (entlast))
_.REGEN
(command "_.EXTRUDE" _c1 "" 10)
(setq _s1 (entlast))
_.REGEN
(command "_.EXTRUDE" _c2 "" 10)
(setq _s2 (entlast))
_.REGEN
(command "_.INTERFERE" _s1 "" _s2 "" "_Y")
_.SAVEAS
2000
C:\Users\SebastianSchoeller\AppData\Local\Temp\kilo\golden\out\Body_AC1015.dwg
(setq RESULT "C:\\Users\\SebastianSchoeller\\AppData\\Local\\Temp\\kilo\\golden\\out\\Body_AC1015_result.txt")
(defun LOGSEC (lines / f) (setq f (open RESULT "a")) (foreach l lines (write-line l f)) (close f))
(LOGSEC (list "probe: Body_AC1015"))
(LOGSEC (list (strcat "census: last=" (cdr (assoc 0 (entget (entlast)))))))
(setq _s (ssget "_X" (list (cons 0 "BODY"))))
(LOGSEC (list (strcat "census: BODY=" (if _s (itoa (sslength _s)) "0"))))
(LOGSEC (list (strcat "dbmod=" (itoa (getvar "DBMOD")))))
(LOGSEC (list "probe-end"))
_.LOGFILEOFF
_.DELAY 1500
_.QUIT
_Y
